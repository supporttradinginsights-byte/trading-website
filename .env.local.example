# Copy this file to .env.local (local dev) and to .env.production (VPS) and
# fill in real values. Nothing in this file is committed with real secrets.
#
# This site has NO public user accounts — every page is open to visitors
# with no sign-in. Firebase + the admin secret below are used ONLY for the
# /admin content-management login.

# ── Backend API ──────────────────────────────────────────────────────────
# Your existing trading-api backend's public URL.
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Locally, if trading-api is running on port 3000:
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Site URL — used for sitemap.xml, canonical links, and Open Graph tags ─
#   NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Firebase (Web app) — used only for /admin login ──────────────────────
# From Firebase Console → Project settings → General → "Your apps" → Web
# app. Must be the SAME Firebase project your app/admin panel already use,
# since admin status is decided by your existing backend (ADMIN_UIDS /
# User.isAdmin / Firebase RTDB admins/{uid}) — whoever can already log into
# your admin app can log into /admin here with the same email/password.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Admin app secret — SERVER-ONLY, do NOT prefix with NEXT_PUBLIC_ ───────
# Must be the exact same value as APP_SECRET in the backend's env. Used only
# inside src/app/api/admin/issue-token/route.js (a server-side proxy) to
# call your existing POST /api/v1/admin/issue-token — never sent to the
# browser. Leave blank if your backend doesn't set APP_SECRET.
ADMIN_APP_SECRET=
